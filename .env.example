PORT=3000
NODE_ENV=production
JISR_HOST_TYPE=cloud
JISR_API_KEY=your_jisr_api_key_here
JISR_SYNC_INTERVAL_MINUTES=5
UNIFI_WEBHOOK_SECRET=your_custom_secure_webhook_secret_here
UNIFI_BASE_URL=https://your-unifi-console-ip-or-domain:12445
UNIFI_API_TOKEN=your_unifi_developer_api_token_here
UNIFI_IGNORE_SSL=false
DEDUPLICATION_WINDOW_SECONDS=60
IN_KEYWORDS=in,entry,entrance,check-in,arrival,start
OUT_KEYWORDS=out,exit,departure,check-out,leave
DEFAULT_DIRECTION=in
