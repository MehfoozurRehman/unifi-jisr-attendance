# Server Configuration
PORT=3000
NODE_ENV=production

# -------------------------------------------------------------
# Jisr HRMS Configuration
# -------------------------------------------------------------
# JISR_HOST_TYPE: 'cloud' (for https://apis.jisr.net) or 'local' (for https://api.jisr.net.sa)
JISR_HOST_TYPE=cloud
# JISR_CUSTOM_BASE_URL=https://apis.jisr.net/api
JISR_API_KEY=your_jisr_api_key_here
JISR_SYNC_INTERVAL_MINUTES=5

# -------------------------------------------------------------
# UniFi Access Configuration
# -------------------------------------------------------------
# Secret token set in UniFi webhook config for Authorization header (Bearer <token>)
UNIFI_WEBHOOK_SECRET=your_custom_secure_webhook_secret_here

# (Optional) Direct UniFi Access API if email is not embedded in webhook payloads
UNIFI_BASE_URL=https://your-unifi-console-ip-or-domain:12445
UNIFI_API_TOKEN=your_unifi_developer_api_token_here
UNIFI_IGNORE_SSL=false

# -------------------------------------------------------------
# Attendance Logic Configuration
# -------------------------------------------------------------
# Prevents duplicate swipes for the same user within X seconds
DEDUPLICATION_WINDOW_SECONDS=60

# Comma-separated lowercase keywords to classify punch as IN or OUT
IN_KEYWORDS=in,entry,entrance,check-in,arrival,start
OUT_KEYWORDS=out,exit,departure,check-out,leave
DEFAULT_DIRECTION=in
