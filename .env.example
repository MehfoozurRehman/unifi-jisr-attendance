# Copy to .env and fill in. Never commit .env.
PORT=3000
UNIFI_BASE_URL=https://192.168.8.1
UNIFI_API_TOKEN=
UNIFI_WEBHOOK_SECRET=
# UniFi's local controller uses a self-signed HTTPS certificate; keep this true unless yours has a real one.
UNIFI_IGNORE_SSL=true
JISR_BASE_URL=https://apis.jisr.net/api
JISR_SLUG=
JISR_API_KEY=
JISR_API_SECRET=
DASHBOARD_PASSWORD=
