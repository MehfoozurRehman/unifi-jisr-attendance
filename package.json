{
  "name": "unifi-jisr-attendance",
  "version": "1.0.0",
  "description": "UniFi Access to Jisr HR Attendance middleware service built with Hono and TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/index.ts",
    "local": "tsx src/local.ts",
    "build": "npm run build:client && tsc",
    "build:client": "vite build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "unifi",
    "unifi-access",
    "jisr",
    "attendance",
    "hono",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
